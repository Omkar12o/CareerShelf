# ─────────────────────────────────────────────────────────────────────────────
# CareerShelf 24/7 deployment — copy to deploy/.env and fill in the blanks.
# NEVER commit the filled file: it contains live payment secrets.
# `bash deploy/install.sh` auto-generates any blank *_KEY / *_TOKEN below.
# ─────────────────────────────────────────────────────────────────────────────

# Public HTTPS origin for the whole stack, no trailing slash.
# Use a real domain or DuckDNS, e.g. https://careershelf.duckdns.org
PUBLIC_ORIGIN=https://careershelf.example.com

# The permanent GitHub Pages link. Kept in the CORS/frame allowlists so the
# shared URL keeps working after you point it at this server.
PAGES_ORIGIN=https://omkar12o.github.io

# ── Supabase (store catalog + orders + auth already live here) ───────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Youpi merchant credentials (copy the same values you use locally) ────────
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=

# ── Receiving account / branding ─────────────────────────────────────────────
# The UPI VPA that actually receives the money. NEVER commit this file.
DEFAULT_PAYEE_VPA=
PAYEE_NAME=
DEFAULT_MERCHANT_NAME=CareerShelf
DEFAULT_MERCHANT_SLUG=careershelf
DEFAULT_APP_NAME=CareerShelf
DEFAULT_PRIMARY_COLOR=#0f172a
DEFAULT_SUPPORT_EMAIL=
DEFAULT_SUPPORT_PHONE=
PHONEPE_REGISTERED_MOBILE=

# ── Android observer enrollment (the phone that reads the bank SMS) ──────────
# Any long random string; the observer app must be configured with the same one.
ANDROID_ENROLLMENT_SECRET=

# ── Server-side crypto material (leave BLANK on first install) ───────────────
# install.sh generates strong values once and they must never change afterwards,
# or previously encrypted merchant secrets become unreadable.
ENCRYPTION_MASTER_KEY=
OBSERVER_API_TOKEN=
ADMIN_API_TOKEN=
INTERNAL_SERVICE_TOKEN=
DEVICE_CREDENTIAL_KEY=
BLIND_INDEX_KEY=
